# Variáveis de Ambiente - Preventiva Norte

# Analytics — create a NEW GA4 property and GTM container for Preventiva Norte.
# Do not reuse Centro's or Este's IDs.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=

# Lead capture — create a Resend account (resend.com) and generate an API
# key. Used server-side only (src/app/api/submit-form) to email contact and
# kit-order submissions, including file attachments, to
# comercial@preventivanorte.com.
RESEND_API_KEY=
